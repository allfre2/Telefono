{
  "name": "telefono",
  "version": "0.1.0",
  "description": "WebRTC calls library",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "browser": {
    "[module-name]": false
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "webpack": "webpack --stats-error-details",
    "build": "npm run build:cjs && npm run build:esm && npm run webpack",
    "clean": "rm -rf dist",
    "purge": "rm -rf dist && rm -rf node_modules && rm -rf package-lock.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "Alfredo Luzón",
  "license": "",
  "type": "module",
  "devDependencies": {
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  }
}
